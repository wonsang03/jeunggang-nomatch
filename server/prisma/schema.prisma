generator client {
  provider = "prisma-client-js"
}

// 로컬은 SQLite. 배포 시 provider = "postgresql" + DATABASE_URL 변경
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  nickname     String
  avatarUrl    String?  // /uploads/avatars/xxx.webp 등
  isAdmin      Boolean  @default(false)
  musicVolume  Int      @default(70) // 0~100 노래 볼륨
  sfxVolume    Int      @default(55) // 0~100 효과음 볼륨
  createdAt    DateTime @default(now())
  gameEntries  GameRecordEntry[]
}

model Genre {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
}

model Question {
  id         String       @id @default(cuid())
  youtubeUrl String
  startSec   Int
  endSec     Int
  genreId    String
  genre      Genre        @relation(fields: [genreId], references: [id])
  /** JSON string[] 예: ["남돌","10년대"] — 혼성이면 성별 태그 없음 */
  tags       String       @default("[]")
  enabled    Boolean      @default(true)
  slots      AnswerSlot[]
  createdAt  DateTime     @default(now())

  @@index([genreId, enabled])
}

model AnswerSlot {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label          String
  answer         String
  acceptAnswers  String   @default("[]") // JSON string array
  hidden         Boolean  @default(false) // 제목·가수 맞힌 뒤 공개되는 히든 문제
  sortOrder      Int      @default(0)
}

model Augment {
  id          String  @id @default(cuid())
  name        String
  description String
  effectType  String
  effectValue String  @default("{}") // JSON
  tier        String  @default("bronze")
  imageUrl    String? // /augments/xxx.jpg 등
  enabled     Boolean @default(true)

  @@unique([name, tier])
}

/**
 * 한 판의 결과. 예전 Score 모델은 정의만 있고 한 번도 쓰이지 않아 걷어냈다.
 * (판 단위로 묶여야 등수·모드·판수를 셀 수 있다)
 */
model GameRecord {
  id          String   @id @default(cuid())
  roomName    String
  gameMode    String   // nomatch | reading
  answerMode  String   // title | title_artist
  totalRounds Int      @default(0)
  playedAt    DateTime @default(now())
  entries     GameRecordEntry[]

  @@index([playedAt])
}

model GameRecordEntry {
  id       String     @id @default(cuid())
  gameId   String
  game     GameRecord @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** 그 판에서 쓰던 닉네임 (나중에 바꿔도 기록은 그대로) */
  nickname String
  score    Int
  rank     Int

  @@index([userId])
  @@index([gameId])
}
