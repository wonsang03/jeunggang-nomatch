# Environment
DATABASE_URL="file:./dev.db"

# 필수. 없거나 32자 미만이거나 예시값이면 서버가 뜨지 않는다.
# 생성:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ※ 바꾸면 기존 토큰이 전부 무효가 되어 접속자 전원 재로그인이 필요하다.
JWT_SECRET=""

PORT=4000

# 접속을 허용할 웹 오리진 (쉼표 구분).
# "*" 를 쓰면 모든 오리진을 허용하되 credentials 는 자동으로 꺼진다. 운영에서는 실제 도메인을 적을 것.
CLIENT_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# --- 시드(선택) ---
# 관리자 계정을 만들 때 쓸 비밀번호. 없으면 기본 계정을 만들지 않는다.
# SEED_ADMIN_PASSWORD=""
# 로컬 전용: admin/admin1234 · test/test1234 를 그대로 만든다. 운영에서는 절대 켜지 말 것.
# SEED_DEFAULT_ACCOUNTS=1
